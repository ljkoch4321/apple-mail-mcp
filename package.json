{
  "name": "apple-mail-mcp",
  "version": "1.1.0",
  "description": "MCP connector for Apple Mail (macOS)",
  "main": "dist/index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.js --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/index.js"
  },
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "apple-mail-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "jxa",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=18"
  }
}
